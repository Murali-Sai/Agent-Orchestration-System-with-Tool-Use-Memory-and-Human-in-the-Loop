# Required
OPENAI_API_KEY=your_openai_key_here

# Optional — enables Anthropic/Claude routing
ANTHROPIC_API_KEY=your_anthropic_key_here

# Supabase — enables persistent task storage & audit logs (optional but recommended)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional — better web search (falls back to DuckDuckGo if absent)
TAVILY_API_KEY=your_tavily_key_here

# Redis (auto-configured in Docker; change for external Redis)
REDIS_URL=redis://localhost:6379/0

# Long-term memory lives in Supabase pgvector (see SUPABASE_URL above) —
# no separate vector store to configure.

# Tracing — spans are always created; these control whether they're exported.
# Set the OTLP endpoint to ship to Jaeger/Tempo/Honeycomb (docker-compose wires
# this to the bundled Jaeger automatically). Leave both unset for silence.
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
# OTEL_CONSOLE_EXPORT=true

# MCP tool servers bridged into the tool registry
ENABLE_MCP=true
MCP_SERVERS=workspace

# Human-in-the-loop thresholds
CONFIDENCE_THRESHOLD=0.6
QUALITY_THRESHOLD=0.65
MAX_RETRIES=2

# App settings
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000
UI_PORT=8501
